{
  "name": "Swipix",
  "slug": "swipix",
  "version": "1.0.0",
  "description": "Swipe through photos and videos to clean up and reclaim storage on your phone.",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "backgroundColor": "#000000",
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#f2f2f7"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#000000"
    },
    "permissions": [
      "android.permission.READ_EXTERNAL_STORAGE",
      "android.permission.WRITE_EXTERNAL_STORAGE",
      "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
      "android.permission.READ_MEDIA_IMAGES",
      "android.permission.READ_MEDIA_VIDEO"
    ],
    "package": "dev.bosetti.swipix"
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "expo-font",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash-icon.png",
        "imageWidth": 220,
        "resizeMode": "contain",
        "backgroundColor": "#f2f2f7",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000"
        }
      }
    ],
    "expo-localization",
    [
      "expo-media-library",
      {
        "photosPermission": "Swipix accesses your photos and videos so you can review and clean them up. Nothing is ever uploaded or shared."
      }
    ],
    "expo-video",
    [
      "react-native-google-mobile-ads",
      {
        "androidAppId": "ca-app-pub-4602631443411685~9053672551",
        "iosAppId": "ca-app-pub-4602631443411685~3043029488"
      }
    ]
  ],
  "ios": {
    "bundleIdentifier": "dev.bosetti.swipix"
  },
  "extra": {
    "eas": {
      "projectId": "eae14ac9-5a39-4a48-91f9-b1ae7bf27d87"
    }
  }
}
