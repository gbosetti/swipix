{
  "name": "swipix",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check-exact-deps": "node scripts/check-exact-deps.js",
    "ios:reset-demo": "bash scripts/reset-ios-demo-device.sh",
    "release:ios": "bash scripts/release-ios.sh",
    "release:android": "bash scripts/release-android.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.18.11",
    "@react-navigation/elements": "2.9.33",
    "@react-navigation/native": "7.3.11",
    "@react-navigation/native-stack": "7.18.3",
    "@sentry/react-native": "8.23.0",
    "expo": "54.0.36",
    "expo-asset": "12.0.13",
    "expo-clipboard": "8.0.8",
    "expo-constants": "18.0.13",
    "expo-dev-client": "6.0.21",
    "expo-device": "8.0.10",
    "expo-file-system": "19.0.23",
    "expo-font": "14.0.12",
    "expo-image": "3.0.11",
    "expo-image-manipulator": "14.0.8",
    "expo-localization": "17.0.9",
    "expo-media-library": "18.2.1",
    "expo-sharing": "14.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "expo-store-review": "9.0.9",
    "expo-video": "3.0.16",
    "i18next": "26.3.6",
    "jpeg-js": "0.4.4",
    "react": "19.1.0",
    "react-i18next": "17.0.10",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-google-mobile-ads": "16.0.0",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "8.57.1",
    "eslint-config-expo": "10.0.0",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "sharp": "0.35.3",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/.*))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "@sentry/cli@3.6.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
